+void BK_Apunta(const char* texto) {
+    // Ojo: NADA de uwp_ProcessEvents aqui. Despachar la cola desde la funcion de migas reentra en
+    // la vista de la aplicacion y reinicia el arranque. Ver bk_quitar_bombeo.py.
+    char* base = SDL_GetPrefPath("", "");
+    if (base == NULL) {
+        return;
+    }
+    char ruta[512];
+    snprintf(ruta, sizeof(ruta), "%sarranque.txt", base);
+    static const unsigned long long inicio = GetTickCount64();
+    FILE* f = fopen(ruta, "a");
+    if (f != NULL) {
+        fprintf(f, "[%6llu ms] %s\n", GetTickCount64() - inicio, texto);
+        fclose(f);
+    }
+    SDL_free(base);
+}
